{
  /*
      MOCKNEVIS APPSETTINGS
  */

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Corppass": {
    "Preferences": {
      /* Delay before the self posting form self posts itself. 
         Set any negative value to disable automatic self posting.
         n.b. if you post after token has expired the login should fail
      */
      "SelfPostDelaySeconds": 3
    },

    "Locations": {
      "Application": "http://localhost:28800/resp/iamentitylogin",
      "SignaturePrivateKeyPath": "./mock-nevis-private-key.pem",
      "EncryptionPublicKeyPath" : ""
    },

    "Token": {

      /* Name of the form parameter in which the token will be submitted */
      "TokenParameter": "token",

      /* Name of the claim containing the entityInfo */
      "EntityInfoClaim": "entityInfo",

      /* Value to pass for the entityInfo claim. This is json so needs escaping here. 
       UEN (to matchsample's uId) goes in the CPEntID section */
      "EntityInfo": "{ \"CPEntID\": \"testco\", \"CPEnt_TYPE\": \"UEN\",\r\n\"CPEnt_Status\": \"Registered\", \"CPNonUEN_Country\": \"\",\r\n\"CPNonUEN_RegNo\": \"\", \"CPNonUEN_Name\": \"\" }",

      "Audience": "http://localhost:28800/resp/iamentitylogin",

      "Issuer": "swz.MockNevis",

      "ExpirySeconds": 60, //token validity lifespan

      /* Algorithm to sign the JWT, as per values in Microsoft.IdentityModel.Tokens.SecurityAlgorithms */
      "SignatureAlgorithm": "RS384"
    }
  },

  /* for now using same settings as corppass as we haven't added the singpass callback to misp yet */
  "Singpass": {
    "Preferences": {
      /* Delay before the self posting form self posts itself. 
         Set any negative value to disable automatic self posting.
         n.b. if you post after token has expired the login should fail
      */
      "SelfPostDelaySeconds": 3
    },

    "Locations": {
      "Application": "http://localhost:28800/resp/iamindividuallogin",
      "SignaturePrivateKeyPath": "./mock-nevis-private-key.pem", //used to sign the jws
      //"EncryptionPublicKeyPath": "./surveyplus-dev-public.pem", //used for the keywrap encryption
      "EncryptionPublicKeyPath": "./surveyplus-dev-public.cer" //used for the keywrap encryption
    },

    "Token": {

      /* Algorithm used for CEK Encrytion (If blank then does not use JWE encryption) e.g. "RSA-OAEP" */
      "WrapEncryptionAlgorithm": "RSA-OAEP",
      //"WrapEncryptionAlgorithm": "",

      /* Algorithm that encodes the JWS payload of the JWE e.g. "A256CBC-HS512" (note that A256GCM isn't supported by .Net for this) */
      "DataEncryptionAlgorithm": "A256CBC-HS512",
      //"DataEncryptionAlgorithm": "",

      /* Name of the form parameter in which the token will be submitted */
      "TokenParameter": "token",

      /* Name of the claim containing the entityInfo, for singpass this is sub */
      "EntityInfoClaim": "sub",

      /* Value to pass for the sub claim. Specify the UID as s, nevis would also send a u which we dont use yet */
      "EntityInfo": "s=fourtech,u=0a54367d-1d07-4ce3-8e86-c87d6b62922d",

      "Audience": "http://localhost:28800/resp/iamindividuallogin",

      "Issuer": "swz.MockNevis",

      "ExpirySeconds": 60, //token validity lifespan

      /* Algorithm to sign the JWT, as per values in Microsoft.IdentityModel.Tokens.SecurityAlgorithms */
      "SignatureAlgorithm": "RS384"
    }
  },

  "AllowedHosts": "*"
}
