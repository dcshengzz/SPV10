{
  /*
        INTERNET DEV APPSETTINGS
  */

  "SurveyPlus": {
    "LogPath": "Logs/DevLogs-{Date}.log" //Startup.cs will pass this to Serilog
  },

  /* Development environment logging levels  
    Trace (will show as [Verbose])
    Debug
    Information
    Warning
    Error
    Critical (will show as [Fatal]

    Turn on lower levels when debugging (suggest just enable for the categories you are working with).
    Leave at warning level otherwise, or will be quite spammy.
  */
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      //"swz.SurveyPlus.InternetWeb.Startup": "Information",
      //"swz.SurveyPlus.InternetWeb.Controllers.DataController": "Trace",
      //"swz.Clover.Core.View.ApiDataSource": "Trace",
      "swz.SurveyPlus.ApiSupport.UAppUtils": "Debug",
      "swz.SurveyPlus.ApiSupport.InternetApiTokenManager": "Trace",
      //"swz.SurveyPlus.ApiSupport.InternetApiMetadataProvider": "Trace",
      //"swz.SurveyPlus.ApiSupport.MemoryMetadataSourceCache": "Trace",
      "swz.Clover.Core.Metadata.MetadataCaches": "Trace",
      "System": "Warning",
      "Hangfire": "Warning",
      "Microsoft": "Warning"
    }
  }
}
