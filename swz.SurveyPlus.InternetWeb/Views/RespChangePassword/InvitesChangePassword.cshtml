@{
    Layout = "_RespLayout";
}
<head>

    <link href="~/css/sgds.css" rel="stylesheet" />
    <style>
        #parent {
            position: relative;
            height: calc(100vh - 80px);
            background: #F9F9F9;
        }

        #child {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 20%;
            right: 20%;
            height: 50%;
            margin: auto;
            z-index: 1000;
        }

        #content {
            background: #FFFFFF;
            box-shadow: 0 4px 24px 0 rgba(45,45,45,0.20);
            border-radius: 2px;
            padding-top: 40px;
            padding-bottom: 40px;
        }


        @@media only screen and (max-width: 997px) {
            #child {
                position: relative;
                top: 20%;
                left: 0;
                right: 0;
            }
        }
    </style>
</head>

@* Common SurveyPlus JavaScript framework functions.
    Update v when file changes to assist cache invalidations. *@
<script src="@Url.Content("~/js/surveyplus-utils.js?ver=20260713")" type="text/javascript"></script>
@* -- *@

<div id="parent">
    <div id="child">
        <div id="content" class="container"></div>
    </div>
</div>

<script src="@Url.Content("~/js/inviteschangepassword.js")"></script>
