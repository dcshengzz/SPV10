@{
    Layout = "_Layout";
}
<head>

    <link href="~/css/sgds.css?ver=1785" rel="stylesheet" />
    <style>
        #parent {
            position: relative;
            height: calc(100vh - 80px);
            background: #F9F9F9;
        }

        #child {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 20%;
            right: 20%;
            height: 50%;
            margin: auto;
            z-index: 1000;
        }

        #content {
            background: #FFFFFF;
            box-shadow: 0 4px 24px 0 rgba(45,45,45,0.20);
            border-radius: 2px;
            padding-top: 40px;
            padding-bottom: 40px;
            text-align: center;
        }
    </style>
</head>


<div id="parent">
    <div id="child">
        <div id="content">
            <h1>Survey response is complete.</h1>
            <h2>Thank You!</h2>
        </div>
    </div>
</div>


