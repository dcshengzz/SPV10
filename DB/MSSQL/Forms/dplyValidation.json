                    "key": "button_3",
                    "data-buildertype": "button",
                    "content": "Upload CSV",
                    "primary": false,
                    "secondary": true,
                    "events": {
                      "onClick": {
                        "active": true,
                        "actions": [
                          "onClickUpload"
