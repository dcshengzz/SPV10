                            "style-marginTop": "20px",
                            "style-marginBottom": "20px",
                            "style-source": "text-align: right;"
                          }
                        ],
                        "style-marginBottom": ""
                      }
                    ],
                    "style-width": "600px"
                  }
                ],
                "style-marginBottom": "10px",
                "style-marginTop": "20px"
              },
              {
                "key": "staticcontent_2",
                "data-buildertype": "staticcontent",
