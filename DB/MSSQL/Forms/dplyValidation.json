                        "active": true,
                        "actions": [
                          "test"
                        ],
                        "targets": [],
                        "parameters": []
                      }
                    },
                    "style-hidden": true,
                    "customPostUrl": "",
                    "other-visibleConition": ""
                  }
                ]
              },
