                                "data-buildertype": "button",
                                "content": "Clear",
                                "secondary": false,
                                "floated": "",
                                "primary": true,
                                "style-marginRight": "20px",
                                "events": {
                                  "onClick": {
                                    "active": true,
                                    "actions": [
                                      "clearDatasets"
                                    ],
                                    "targets": [
                                      "mdl_ClearDatasets"
                                    ],
                                    "parameters": []
                                  }
                                }
                              },
                              {
                                "key": "btn_Cancel",
                                "data-buildertype": "button",
                                "content": "Cancel",
                                "floated": "",
