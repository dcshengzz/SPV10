                                "events": {
                                  "onClick": {
                                    "active": true,
                                    "actions": [
                                      "cancelModal"
                                    ],
                                    "targets": [
                                      "mdl_ClearDatasets"
                                    ],
                                    "parameters": []
                                  }
                                },
                                "style-marginRight": "20px"
                              }
