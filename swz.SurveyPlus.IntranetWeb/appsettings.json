{
  /*
      INTRANET APPSETTINGS
  */

  /* How to handle startup exceptions. One of TerminateAndExit, Throw */
  "StartupExceptionHandling": "Throw",

  "Clover": {

    /* Sets the timeout for most^ stored procedure calls (default if not specified is 30 seconds) 
       A value of 0 will disable the timeout (but this is not recommended).
       (^ Certain stored-procedures have a fixed timeout of 3600 and are unaffected by this setting).
       This setting is likely to be replaced with finer-grained settings in a future version. */
    "StoredProcedureTimeoutSeconds": 60,

    /* Set to false in production environment */
    "IsEnableSwaggerFile": false,

    /* Set to false */
    "BlockMetadataChanges": false,

    /* Tells the CloverRuntime whether to use metadatacaches for certain operations.
       In production leave it as true, in development environments it can be useful to set to false.  
       Previously this was based on compile-time built type (RELEASE vs DEBUG) */
    "UseMetadataCache": true,

    /* Set to "Admins" */
    "AdminRole": "Admins",

    /* Enable intranet login with username/password */
    "IsPasswordAuthentication": true,

    /* Enable intranet login with Windows Authentication (e.g. AD Login).
       This requires that IIS is also configured for Windows Authentication. */
    "IsWindowsAuthentication": true,

    /* Customise label for the Windows Authentication login button */
    "LoginWithWindowsAuthenticationLabel": "Login with Windows Authentication",

    /* Enable the SAML2 authentication flow (e.g. AAD Login) */
    "IsSaml2Authentication": true,

    /* Customise label for the SAML2 login button */
    "LoginWithSaml2AuthenticationLabel": "Sign in with Microsoft",

    /* Path to use for compilation files generated by the Code Action feature when in debug mode. 
       A valid path is required when using the debug mode of the CodeActionsCompiler.
       May be absolute or relative. Ensure the identity running the application has access to write here. */
    "CodeActionFolderPath": "Temp"
  },

  "SurveyPlus": {
    /* Image branding path to display on wwwroot/<branding>/*, file to display favicon.ico, logo.png */
    "BrandingImagePath": "sims",

    /* Show the Help link in the UI */
    "IsHelpEnabled": true,

    /* Backoffice-facing succinct name of the application used in tab titles and some filenames,
      this should be changed in conjunction with the title setting managed in the application admin
      dashboard. WARNING: Do not include html in this name because it will be escaped in pages, 
      and please ensure all characters used are suitable for inclusion in generated filenames. */
    "ShortApplicationName": "SurveyPlus",

    /* Duration after which the auth cookie will be rejected regardless of extensions.
       This doesn't have a friendly client-side UX so should be longer than a human user
       might reasonably be expected to continuously use the application (e.g. 720 minutes = 12 hours)*/
    "MaxAuthMinutes": 720,

    /* Auth Cookie expiry timespan (in minutes). 
       For UX reasons this should be longer than SessionTimeoutMinutes */
    "AuthTimeoutMinutes": 20,

    /* User-friendly Session Timeout duration (in minutes) */
    "SessionTimeoutMinutes": 15,

    /* Alert duration Before Session Timeout (in minutes) */
    "SessionTimeoutAlertMinutes": 13,

    //"EnableSpammyLogsInProductionBecauseImTroubleshooting": true,

    /* Path for serilog log files. Can be absolute or relative. 
       Ensure the identity running the application has access to write here */
    "LogPath": "Logs/UATLogs-{Date}.txt",

    /* Number of serilog log files to retain (older ones will be cleaned up, use -1 for unlimited) */
    "LogRetainedFileCountLimit": 31,

    /* Expired FileTicket Cleanup Job Schedule (if empty or missing the job is disabled) cron syntax UTC */
    "CleanupExpiredFileTicketsSchedule": "0 * * * *",

    /* Dormant Users Job Schedule (if empty or missing the job is disabled)
       cron syntax UTC (minute hour dayM month dayW) - Subtract 8 hours from desired SGT for UTC */
    "ProcessDormantUsersSchedule": "0 18 * * *",

    /* Access audit export job schedule (if empty or missing the job is disabled)
       exports for previous month , so at start of month is best (eg: 17 Last day UTC is 1am First day SGT) */
    "MonthlyAuditAccessLogExportSchedule": "0 17 L * *",

    /* Path to use for temporary archived audit log files, may be absolute or relative.
       Ensure the identity running the application has access to write & read here */
    "ArchivedAuditLogsFolderPath": "export/ArchivedAuditLogs",

    /* Path to use for temporary respondent-files download zip generation and storage. After generation the
      file is moved to the database. Path specified may be absolute or relative.
       Ensure the identity running the application has access to write & read here */
    "RespFilesDownloadFolderPath": "export/RespFilesDownload",

    /* Path to use for temporary response export file generation. (File will be moved to db after generation) 
       This path may be absolute or relative. Ensure the identity running the application has access to write & read here */
    "ExportedDeploymentResponseFolderPath": "export/ExportedDeploymentResponse",

    /* Folder to use for generation of MailMerge zips (if using ZippedPdfs or ArchivedFolder mode). 
       If this is blank then they will be assembled in memory.
       Currently this is only used for the Deployment messaging. Future versions may add support for the global mailer.
       Old files in this folder may be subject to regular cleanup so do not share this folder with other tasks. 
       Note that this path is also used with ArchivedFolder mail merge type and forms part of the file path when calling the external
       tool so you may need to normalise delimiters to your platform's standard (i.e \\ (escaped \) instead of / on Windows)  */
    "MailMergeFolderPath": "export\\MailMerge",

    /* Full path to external archive tool for mail merge archive creation when using ArchivedFolder mode.
       Individual pdfs will be written to a folder inside the MailMergeFolderPath and then archived using the external tool
       to produce a final archive file to import into the database. (SurveyPlus will delete the temporaty folder and pdfs after
       the external tool has exited and it confirms the existence of the expected archive file. The archive file will be removed
       after it has been copied to the database.
       The value here will be used directly in a System.Diagnostics.ProcessStartInfo object (so may need quotes and escaping)
       and the process will inherit the permissions of the application's process. The identity SurveyPlus runs under may need
       permissions to be configured to see and run the external tool (depending on your environment and setup).
       Example: "\"C:\\Program Files\\7-Zip\\7z.exe\""       */
    "MailMergeArchivedFolderCommand": "\"C:\\Program Files\\7-Zip\\7z.exe\"",

    /* Template for the arguments to the external tool identified in MailMergeArchivedFolderCommand.
       Use {ArchiveName} and {FolderName} placeholders here. The value passed for ArchiveName will include the extension
       specified in MailMergeArchivedFolderExtension so do not add it here.
       Example: "a -y -bd -r -sse -sae -mx9 {ArchiveName} {FolderName}"   */
    "MailMergeArchivedFolderCommandArguments": "a -y -bd -r -sse -sae -mx9 {ArchiveName} {FolderName}",

    /* Extension to use for archive filenames when using the external tool identified in MailMergeArchivedFolderCommand for
       use with the ArchivedFolder mode of mail merge. Do not include the initial '.' character here
       Example "7z"   */
    "MailMergeArchivedFolderExtension": "7z",

    /* Path to use for temporary files generated by the Third Party integration API. May be absolute or relative.
       Ensure the identity running the application has access to write & read here */
    "RespFiles3PAFolderPath": "export/3PA",

    /* Maximum size in bytes for the the zipped-csv respondent data attachment in a Scheduled Export.
       e.g 3145728 is 3 MiB. For larger files, a download link will be provided.  
       Set to 0 to disable the attachment and always send link. */
    "ScheduledExportResponseAttachmentBytes": 0,

    /* Maximum size in bytes for the the zipped respondent files attachment in a Scheduled Export.
       For larger files, a download link will be provided. Set to 0 to disable the attachment and always send link. */
    "ScheduledExportUploadsAttachmentBytes": 0,

    /* Number of hours the response data and file extract download links will remain valid before they expire. */
    "ResponseDownloadLinkExpiryHours": 48,

    /* Timing of the daily report snapshots job. (if empty or missing the job is disabled)
       IMPORTANT NOTE: If changing the default timing, please continue to ensure the job is run on a DAILY basis for report accuracy
       cron syntax UTC (minute hour dayM month dayW) - Subtract 8 hours from desired SGT for UTC. Usual value is "30 15 * * *" 
    */
    "TakeReportSnapshotSchedule": "30 15 * * *",

    /* Validate License Expiry Schedule (if empty or missing the job is disabled)
       cron syntax UTC (minute hour dayM month dayW) - Subtract 8 hours from desired SGT for UTC */
    "ValidateLicenseExpirySchedule": "0 16 * * *",

    /* Number of days before license expiration to trigger license expiry notification. */
    "LicenseExpiryDays": 30,

    /* Expired JWT Cleanup Job Schedule (if empty or missing the job is disabled) cron syntax UTC */
    "CleanupExpiredJsonWebTokensSchedule": "0 17 * * *",

    /* Interval to check the database for changes to metadata and flush the metadata cache if necessary. 
       If this is 0 or negative, or Clover::UseMetadataCache is false then the service is not started.
       Recommended interval is every 5 minutes.
    */
    "MetadataCacheCheckMinutes": 5

  },

  "DataManagement": {
    /* Specifies where ASP.NET Core Session data is held. Memory is only suitable for single-server
       environment or where sticky session affinity is configured in the load balanacer. Current versions
       of SurveyPlus use minimal session data for the intranet application and Database is thus a suitable
       choice for most environments.
       One of Memory|Database  */
    "StoreSessionIn": "Database",

    /* Specifies how ASP.NET will manage its encryption keys (e.g. for cookies and session).
       One of DefaultDiscovery|AmazonSSM|Ephemeral|FileSystem  */
    "DataProtection": "DefaultDiscovery"
  },

  "ThirdPartyApi": {

    /* Enable the Third Party integration API */
    "IsEnabled": false,

    /// <summary>
    /// Used for signing respondent tokens for 3PA API.
    /// Value here is obfuscated as per EncryptionHelper using the constants LoginKey and LoginIv.
    /// Recommend to generate the key from 64 crypto-random bytes (represented as base64) (and then encrypt)
    /// </summary>
    "EncryptedTokenKey": "8V41u4wiKGsOYSzERMGE4jfZKLM9s+HVqTb8M1ko3wfyXRo1Isks8VDm82FT68Z0zT3i/VqUj/w9LR4czLUn6leok0jcLH/9iInFseCDtC6u+yQ6zFXWXloger9OyF20"

  },

  /* Production logging levels (to adjust for development environment see appsettings.Development.json)
    For more info see: https://docs.microsoft.com/en-us/aspnet/core/fundamentals/logging/?view=aspnetcore-3.1 
    Using Critical for System to avoid logging too much info in production. 

    Only configure levels below information while diagnosing a specific issue because these can result in huge quantities of logging!
    (Note: configuring logs below Information level in production requires an additional special setting. Refer to Startup.cs for details)
  */
  "Logging": {
    "LogLevel": {

      /* Default log level if not specifically specified below. Recommend "Information" in production environment */
      "Default": "Information",

      /* For the Startup classes we recommend "Information" in Production */
      "swz.SurveyPlus.IntranetWeb.StartupIntranet": "Information",

      /* For System classes we recommend "Critical" to avoid logging too much info in production.  */
      "System": "Critical",

      "Microsoft": "Warning",

      /* Log level for the Hangfire job scheduler. Recommended "Warning" in production */
      "Hangfire": "Warning",

      "Microsoft.AspNetCore.Session.SessionMiddleware": "Error",
      "Microsoft.AspNetCore.DataProtection": "Warning",

      "swz.SurveyPlus.IntranetApplication.Import.ResponseImporter": "Debug",
      "swz.SurveyPlus.IntranetApplication.Import.ResponseImportService": "Debug"
    }
  },

  /* Controls some response headers that are useful for security. */
  "SecurityHeaders": {

    /* Value to use for the Referrer-Policy header, or empty to not set it explicitly. 
       The provided value must be one of:
       "no-referrer" (unsupported), "no-referrer-when-downgrade", "origin" , 
       "origin-when-cross-origin", "same-origin" (recommended), "strict-origin", 
       "strict-origin-when-cross-origin", "unsafe-url" */
    "ReferrerPolicy": "same-origin",

    /* One of Unspecified, None , Lax, Strict (recommended) for the auth and session cookie */
    "AspSameSite": "Strict",

    /* If true (recommended) will set X-Content-Type-Options: nosniff */
    "NoSniff": true,

    /* One of NONE, DENY (recommended), SAMEORIGIN to control setting X-Frame-Options header */
    "XFrameOptions": "DENY",

    /* X-XSS-Protection to detect XSS attacks, Option: 0, 1, 1;mode=block, leave blank to not
       set this header (recommended because it is a legacy header) */
    "XXSSProtection": "",

    /* Settings to manage the Content Security Policy header */
    "ContentSecurityPolicy": {

      /* CSP should be left enabled for security, but can be disabled here for troubleshooting */
      "IsEnabled": true,

      /* Additional values to go in the script-src of the CSP header (array syntax) */
      "AdditionalScriptSrc": [],

      /* Additional values to go in the img-src of the CSP header (array syntax) */
      "AdditionalImgSrc": [],

      /* Additional values to go in the connect-src of the CSP header (array syntax) */
      "AdditionalConnectSrc": [],

      /* Additional values to go in the style-src of the CSP header (array syntax) */
      "AdditionalStyleSrc": [],

      /* Additional values to go in the font-src of the CSP header (array syntax) */
      "AdditionalFontSrc": [],

      /* Values for the frame-src of CSP header (array syntax, empty array to not include any frame-src)
         Recommended value is 'none' (including the single quotes) */
      "FrameSrc": [ "'none'" ],

      /* Values for the frame-ancestors of CSP header (array syntax, empty array to not include any frame-ancestors)
         Recommended value is 'none' (including the single quotes) */
      "FrameAncestors": [ "'none'" ],

      /* Values for the base-uri of CSP header (array syntax, empty array will not add any base-uri)
         Recommended value is 'none' (must include the single quotes around it) */
      "BaseUri": [ "'none'" ]
    },

    /* Values for the Cache-Control (HTTP 1.1), Pragma and Expires (HTTP 1.0) of header */
    "CacheControl": "no-cache,no-store,must-revalidate,max-age=0",
    "Pragma": "no-cache",
    "Expires": "0"
  },

  "ConnectionStrings": {

    /*  When deploying in staging or production environments can delete any extraneous content in this ConnectionStrings block.
        Only the "default" connection string is required here. Remove this comment in production as it is superflous there.
    
        FYI, System.Data.Sql -> Microsoft.Data.Sql on dev environment, please edit the connection string.
        Reason: Encrypt is now set to true by default and this may fail unsecure/not SSL environment. Fix by setting 
        TrustServerCertificate=True; or Encrypt=False;
    */
    "default": "Data Source=KSLAPTOP\\SQLEXPRESS;Initial Catalog=prepv8;Connect Timeout=45;TrustServerCertificate=true;User ID=kstest;Password=P@ssw0rd"
  },

  "LicenseControl": {
    "DomainNameRequired": "True",
    "PerServer": "True"
  },

  "HelloController": {
    /* Query parameter value required to view the debug/license page.This provides only the most minimal of security
       as such parameters are liable to be logged and are visible in the address bar history. For production environments
       you may wish to set this value to an empty string to disable the page when not performing troubleshooting.
       n.b It is best to access this troubleshooter page using an incognito window while not logged into the application.
    */
    "DebugLicenseAccessCode": "helloWORLD123",

    /* Query parameter value required to view the debug/authentication page. This provides only the most minimal of security
       as such parameters are liable to be logged and are visible in the address bar history. For production environments 
       it is recomended to set this value to an empty string to disable the page when not performing troubleshooting */
    "DebugAuthenticationAccessCode": "helloWORLD123"
  },

  "UnifiedAtApp": {
    /* This must be set to true in this version of SurveyPlus */
    "IsEnabled": true,

    /* Enables a U@App intranet endpoint used in the SPCP login process. 
       It is recommended to set false in production environments that don't use SPCP login */
    "IsSPCPLoginEndpointEnabled": true,

    /* A secret key used by the internet and intranet in the U@App API.
       Put the encrypted value here, not the raw value */
    "EncryptedApiKey": "lXSp5P0GvfUtg6OfXSimEVkcPQkzMhIuWSYau77iY/P7HgUn0MtGS7ou5EqxcZR7",

    /* A secret key used by intranet application for respondent token signing in the U@App API.
       Put the encrypted value here, not the raw value */
    "EncryptedTokenKey": "FC/7EBb97C5vXqIlBvd+B4A/96drVP41702bthnKhOLMB/KWgVAffNY79JoswAZvrQIF+USYGm1hn6YLNACio8MJ6/A4gb887saLrzBxeSiuEcG11EWd2w5kOCtx6FsY",

    /* When true, the application will track respondent login and invalidate old sessions on a new login
       to enforce login from a single browser at one time */
    "IsEnforceRespondentSingleSession": false,

    /* When true api/conectivitytest returns an informational message, when false it just returns 204 response.
       In publicily facing intranet servers it is recommended to keep false except when installing or troubleshooting */
    "IsEnableConnectivityTestResult": true,

    /* If true then the machine name of the intranet server will be revealed in the returned result */
    "IsConnectivityTestIncludeMachineInfo": false
  },

  "PrintSettings": {
    //Pdf export feature in respondent dashboard page.
    "PdfExport": {
      //This must be set to true to ensure pdf export feature working in respondent dashboard page.
      "IsEnabled": true,
      //Cooldown period (in minutes) required before a user can export another PDF for the same survey response.
      "CooldownMinutes": 5
    }
   },

  "AWSSecretsManager": {
    "IsEnabled": false,
    "IsUseLazyProvider": true,
    "SecretName": "Local_SurveyPlus_Credentials",
    "Region": "ap-southeast-2",
    //Set to "AWSCURRENT" to retrieve the active version of the secret.
    "VersionStage": "AWSCURRENT"
  },

  "IamSettings": {
    "IsEnabled": true,
    "SecretKey": "456",
    "RequestExpiry": "180"
  },

  "AuditLogManager": {
    "Schedule": "0 1 * * *", //"0 1 * * *"
    "AuditExport": {
      "IsEnabled": false,
      "KeepInDbDays": 90,
      "LocalTempPath": "export/AuditExport",
      "CloudProvider": "aws", //aws or azure, azure is not support yet
      "CloudPath": "sp-audit-test",
      "FileName": "SP_"
    },

    "AblrExport": {
      "IsEnabled": false,
      "Path": "export/ABLR", //D:\\ProgramData\\SIMS_Intranet\\TempFiles\AblrExport
      "FileName": "SIMS_",
      "ProjectReference": "SIMS-Reference"
    }
  },

  "SAML2": {

    /* IdP endpoint to which the AuthnRequest is sent */
    "Destination": "http://localhost:27800/saml2/handlerequest",

    /* Specifies which RedirectionUri IdP should send the response to 
       Note that for Entra these URLs must be pre-registered in the portal and are case-sensitive 
       This value is optional and will only be included in AuthnRequest if specified */
    "AssertionConsumerServiceURL": "http://localhost:48800/saml2/acs",

    /* The application's unique identifier as configured in the Identity Provider. 
       This will be set as the Issuer in the AuthnRequest */
    "ServiceProviderEntityID": "http://localhost:48800",

    /* Unique identifier of the Identity Provider 
       This is the expected IssuerID in the Response */
    "IdentityProviderEntityID": "http://localhost:27800",

    /* Specifies whether to set the ForceAuthn or IsPassive flags in the request.
       Valid options are Default, ForceAuthn, Passive */
    "SessionBehaviour": "Default",

    /* When true outgoing requests will be signed with the application's verification private key */
    "IsSignAuthnRequest": true,

    /* If set to true then application will reject a response that does not have a Response-level
       Signature. Note that when false, a Response-level Signature will still be validated if one
       is present in the Response.
       n.b. even if both of IsRequireSignedResponse, IsRequireSignedAssertion are false
            the application will still reject a Response that has neither Signature */
    "IsRequireSignedResponse": true,

    /* If set to true then will reject a response that does not have an Assertion-level
       Signature. If false, an Assertion-level Signature will still be validated when one
       is present in the Response.
       n.b. even if both of IsRequireSignedResponse, IsRequireSignedAssertion are false
            the application will still reject a Response that has neither Signature */
    "IsRequireSignedAssertion": true,

    /* Path to the application's private key that will be used to sign the request. For keys
       in a pfx or store they must be exportable and not have a password */
    "ServiceProviderVerificationPrivateKeyPath": "saml-test-spverification-private-key.pem",

    /* Path to the public certificate provided by the IdP to be used to verify IdP signatures
       in the Response */
    "IdentityProviderVerificationPublicKeyPath": "saml-test-idpsigning-public-key.cer",

    /* Path to the application's private key used to decrypt the assertion (when the IdP
       has been provided with the application's public certificate and configured to encrypt
       the assertion).
       Warning: due to a technical constraint this may need to be loaded from pkcs12 that
                bundles both private and public key (such as a .pfx file), if using a .PEM
                file is resulting in decryption errors at runtime (0xc100000d) */
    //"ServiceProviderEncryptionPrivateKeyPath": "saml-test-spencryption.pfx",
    "ServiceProviderEncryptionPrivateKeyPath": "saml-test-spencryption-private-key.pem",

    /* Expired AssertionID Cleanup Job Schedule (if empty or missing the job is disabled) cron syntax UTC */
    "CleanupExpiredAssertionIDSchedule": "0 * * * *",

    /* If true the Response raw xml will be logged at debug level in the swz.SurveyPlus.Saml2.Saml2Application
       category. Before enabling, consider whether the response and its assertion (if sent unecrypted) will
       contain user information that should not be logged in this environment */
    "IsLogResponseXml": false,

    /* If true the Assertion decrypted xml will be logged at debug level in the
       swz.SurveyPlus.Saml2.Saml2Application category after decryption is performed. 
       Before enabling, consider whether the assertion will contain user information that should not 
       be logged in this environment */
    "IsLogDecryptedAssertionXml": false

  }
}
