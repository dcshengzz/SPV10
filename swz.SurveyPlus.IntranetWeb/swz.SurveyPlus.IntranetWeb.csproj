<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <PreBuildEvent>
    </PreBuildEvent>
	  <PreserveCompilationContext>true</PreserveCompilationContext>
	  <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
	  <RazorCompileOnPublish>false</RazorCompileOnPublish>
	  <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <UserSecretsId>151f932b-0d5a-4152-8800-43319e219a56</UserSecretsId>
  </PropertyGroup>
	<PropertyGroup>
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
	</PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <NoWarn>1701;1702;1998;NETSDK1187</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;1998;NETSDK1187</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Temp\**" />
    <Content Remove="Temp\**" />
    <EmbeddedResource Remove="Temp\**" />
    <None Remove="Temp\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Hangfire" Version="1.8.24" />
    <PackageReference Include="Ixnas.AltchaNet" Version="1.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.Extensions" Version="6.0.36" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.11" />
    <PackageReference Include="Microsoft.CodeAnalysis.Razor" Version="6.0.36" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.11" />   
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="wwwroot\js\login.js" />
  </ItemGroup>
    <ItemGroup>
    <Folder Include="Logs\" />
    <Folder Include="Models\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\swz.SurveyPlus.IdentityAccessManagement\swz.SurveyPlus.IdentityAccessManagement.csproj" />
    <ProjectReference Include="..\swz.Clover.AuthServices.Jwt\swz.Clover.AuthServices.Jwt.csproj" />
    <ProjectReference Include="..\swz.SurveyPlus.IntranetApplication\swz.SurveyPlus.IntranetApplication.csproj" />
    <ProjectReference Include="..\swz.SurveyPlus.Saml2\swz.SurveyPlus.Saml2.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Views\Error\Error404.cshtml">
      <Pack>$(IncludeRazorContentInPack)</Pack>
    </Content>
    <Content Update="Views\Shared\_PublicLayout.cshtml">
      <Pack>$(IncludeRazorContentInPack)</Pack>
    </Content>
  </ItemGroup>
    <ItemGroup>
    <Content Update="Views\ConfigAPIUserAdmin\UserAdmin.cshtml">
      <Pack>$(IncludeRazorContentInPack)</Pack>
    </Content>
  </ItemGroup>
    <ItemGroup>
	    <Content Update="license.key">
		    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	    </Content>
	    <Content Update="appsettings.Development.json">
		    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	    </Content>
	    <Content Update="wwwroot\js\app\**\*">
		    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	    </Content>
	    <Content Update="wwwroot\localization\**\*">
		    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	    </Content>
    </ItemGroup>
    <ItemGroup>
      <None Update="encryption2-nopass.pfx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="saml-test-spencryption-private-key.pem">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </None>
      <None Update="saml-test-spencryption-public-key.cer">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="saml-test-spencryption.pfx">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  
  </Project>