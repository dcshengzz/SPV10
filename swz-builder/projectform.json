                "selection": true,
                "data-elements": "[{key: 1, value: 1, text: 'Fix price'},\n{key: 2, value: 2, text: 'Time & Material'},\n{key: 3, value: 3, text: 'Support'}]",
                "placeholder": "Choose a type of project"
            },
            {
                "key": "datestart",
                "data-buildertype": "input",
                "label": "Data start",
                "fluid": true,
                "type": "date"
            },
            {
                "key": "budget",
                "data-buildertype": "input",
                "label": "Budget",
                "fluid": true,
                "placeholder": "500000.00",
