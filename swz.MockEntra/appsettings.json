{
  /* MockEntra appsettings.json */

  "Saml2": {

    "DefaultUserEmail": "test@example.com",

    "IdentityProviderEntityID": "http://localhost:27800",

    "ServiceProviderAssertionConsumerServiceURL": "http://localhost:48800/saml2/acs",

    "ServiceProviderVerificationPublicKeyPath": "saml-test-spverification-public-key.cer",

    "ServiceProviderEncryptionPublicKeyPath": "saml-test-spencryption-public-key.cer",

    "IdentityProviderSigningPrivateKeyPath": "saml-test-idpsigning-private-key.pem",

    "IsRequireAuthnRequestSignature": true,

    "IsDisableAuthnRequestSignatureVerification": false,

    "IsSignResponse": true,

    "IsSignAssertion": true,

    "IsEncryptAssertion": true
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
